VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never expose this value through a VITE_ variable.
OPENROUTER_API_KEY=
# Pinned Jev release by default; override this when adopting another compatible Decisions API model.
OPENROUTER_DUPLICATE_MODEL=typesafe/jev-1.13
OPENROUTER_DUPLICATE_TIMEOUT_MS=25000

# Optional X Engine workbook override. Defaults to this file in your Downloads folder.
# X_ENGINE_WORKBOOK_PATH=C:/Users/user/Downloads/Founder_Content_Engine_150_Conversation_Questions.xlsx
# Optional Python executable override for isolated spreadsheet reads and writes.
# X_ENGINE_PYTHON=C:/path/to/python.exe
